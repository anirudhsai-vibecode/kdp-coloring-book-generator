# Preferred: Cloudflare Workers AI (FLUX.1-schnell) — free tier ~10k Neurons/day
# Account ID: Cloudflare dashboard → Workers & Pages / overview
# API token: Create Token → Workers AI (Run) permission
#
# Multi-account rotation: on HTTP 429 code 4006 ("daily free allocation" / ~10000 neurons)
# the generator switches to the next unused account immediately. When all are exhausted →
# STATUS PAUSED (resume ~5:30 AM IST). Pollinations/HF are NOT used as fallback.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional rotation accounts (same permissions)
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_API_TOKEN_2=
CLOUDFLARE_ACCOUNT_ID_3=
CLOUDFLARE_API_TOKEN_3=

# Author name shown on cover (CLI --author overrides this)
AUTHOR=Your Name Here
