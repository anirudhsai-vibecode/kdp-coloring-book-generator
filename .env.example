# Preferred: Cloudflare Workers AI (FLUX.1-schnell) — free tier ~10k Neurons/day
# Account ID: Cloudflare dashboard → Workers & Pages / overview
# API token: Create Token → Workers AI (Run) permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Hugging Face API token for alternative image generation
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: override Pollinations base URL (fallback when CF unavailable)
# POLLINATIONS_URL=https://image.pollinations.ai/prompt

# Author name shown on cover (CLI --author overrides this)
AUTHOR=Your Name Here
